# Copier ce fichier en .env si besoin de personnaliser la configuration.

# URL du back-end (voir /backend). En développement, laissez vide : le
# serveur Vite proxifie automatiquement /api/* vers http://localhost:3001
# (voir vite.config.ts). Ne renseigner que pour un déploiement en
# production où le front-end et le back-end sont servis séparément.
# VITE_API_URL=https://api.votre-domaine.example
